---
import { getCollection } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { tools } from '../data/tools';
import Page from '../layouts/Page.astro';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<Page title={SITE_TITLE} description={SITE_DESCRIPTION} wide>
	<section class="hero">
		<p class="eyebrow">xiaoxiaoptopfile.top</p>
		<h1>小小博客</h1>
		<p class="lead">
			这里放开发笔记，也放我自己做的小工具。文章用 Markdown 写，工具都在浏览器里运行。
		</p>
	</section>

	<section>
		<div class="section-head">
			<h2>最新文章</h2>
			<a href="/blog">全部文章 →</a>
		</div>
		<ul class="post-list">
			{
				posts.map((post) => (
					<li>
						<a class="card" href={`/blog/${post.id}/`}>
							<span class="dot" aria-hidden="true"></span>
							<h3>{post.data.title}</h3>
							<p>{post.data.description}</p>
							<time>
								<FormattedDate date={post.data.pubDate} />
							</time>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section>
		<div class="section-head">
			<h2>在线工具</h2>
			<a href="/tools">全部工具 →</a>
		</div>
		<ul class="tool-grid">
			{
				tools.map((tool) => (
					<li>
						<a class="card" href={tool.href}>
							<span class="dot" aria-hidden="true"></span>
							<h3>{tool.title}</h3>
							<p>{tool.description}</p>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Page>

<style>
	.hero {
		margin-bottom: 3rem;
	}
	.eyebrow {
		margin: 0 0 0.5rem;
		color: rgb(var(--gray));
		font-size: 0.9rem;
		letter-spacing: 0.04em;
	}
	.lead {
		font-size: 1.15rem;
		color: rgb(var(--gray-dark));
	}
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.section-head h2 {
		font-size: 1.563em;
		margin: 0;
	}
	.post-list,
	.tool-grid {
		list-style: none;
		margin: 0 0 3rem;
		padding: 0;
		display: grid;
		gap: 1rem;
	}
	.post-list a,
	.tool-grid a {
		padding: 1.1rem 1.8rem 1.1rem 1.2rem;
	}
	.post-list a:hover,
	.tool-grid a:hover {
		color: inherit;
	}
	.post-list h3,
	.tool-grid h3 {
		margin: 0 0 0.4rem;
		font-size: 1.15rem;
	}
	.post-list p,
	.tool-grid p {
		margin: 0 0 0.5rem;
		color: rgb(var(--gray));
		font-size: 0.95rem;
	}
	.post-list time {
		color: rgb(var(--gray));
		font-size: 0.85rem;
	}
	.tool-grid {
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
	}
</style>

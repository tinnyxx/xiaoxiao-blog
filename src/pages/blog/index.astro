---
import { getCollection } from 'astro:content';
import NoteEntry from '../../components/NoteEntry.astro';
import { SITE_TITLE } from '../../consts';
import Page from '../../layouts/Page.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

type Entry = (typeof posts)[number];
type YearGroup = { year: number; items: { post: Entry; index: number }[] };

const groups: YearGroup[] = [];
posts.forEach((post, index) => {
	const year = post.data.pubDate.getFullYear();
	let group = groups[groups.length - 1];
	if (!group || group.year !== year) {
		group = { year, items: [] };
		groups.push(group);
	}
	group.items.push({ post, index: index + 1 });
});
---

<Page title={`文章 | ${SITE_TITLE}`} description="开发笔记、踩坑记录和一些实验。">
	<header class="page-head">
		<p class="label">Notes / Archive</p>
		<h1>文章</h1>
		<p class="intro">
			开发笔记、踩坑记录和一些实验，全部用 Markdown 写。目前共 {posts.length} 篇，按时间倒序排列。
		</p>
	</header>

	{
		groups.map((group) => (
			<section class="year">
				<div class="year-head">
					<span class="year-num mono">{group.year}</span>
					<span class="year-count mono">{String(group.items.length).padStart(2, '0')} notes</span>
				</div>
				<ul>
					{group.items.map(({ post, index }, i) => (
						<NoteEntry
							index={index}
							href={`/blog/${post.id}/`}
							title={post.data.title}
							description={post.data.description}
							date={post.data.pubDate}
							last={i === group.items.length - 1}
						/>
					))}
				</ul>
			</section>
		))
	}
</Page>

<style>
	.page-head {
		margin-bottom: 3.5rem;
		animation: rise 0.55s var(--ease) both;
	}

	.page-head .label {
		margin-bottom: 0.9rem;
	}

	.page-head h1 {
		margin: 0;
		font-size: clamp(2.1rem, 5vw, 3.1rem);
		font-weight: 800;
		letter-spacing: -0.03em;
	}

	.intro {
		margin: 1rem 0 0;
		max-width: 46ch;
		color: var(--muted);
		font-size: 0.95rem;
	}

	.year + .year {
		margin-top: 3.2rem;
	}

	.year-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding-bottom: 0.8rem;
		border-bottom: 1px solid var(--border);
	}

	.year-num {
		color: var(--text);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.1em;
	}

	.year-count {
		font-size: 0.6rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted-soft);
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
</style>

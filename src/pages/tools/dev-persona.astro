---
import { SITE_TITLE } from '../../consts';
import Page from '../../layouts/Page.astro';
---

<Page
	title={`程序员人格测试 | ${SITE_TITLE}`}
	description="十道题，编译出一种程序员人格。根据编码习惯、Debug 方式和面对报错的反应，揭晓你的类型。"
>
	<header class="page-head">
		<a class="back mono" href="/tools">
			<span aria-hidden="true">←</span> Utilities
		</a>
	</header>

	<div class="persona-stage" id="persona-app" data-mode="start">
		<canvas class="particles" data-particles aria-hidden="true"></canvas>
		<div class="orb orb-a" aria-hidden="true"></div>
		<div class="orb orb-b" aria-hidden="true"></div>
		<div class="grid" aria-hidden="true"></div>
		<div class="corners" aria-hidden="true">
			<span></span><span></span><span></span><span></span>
		</div>

		<section class="panel is-on" data-panel="start">
			<p class="kicker mono">Experiment / 03 · Persona</p>
			<h1>程序员人格测试</h1>
			<p class="lede-en mono">A small diagnostic for how you write, debug, and stay up.</p>
			<p class="lede">
				十道题，没有标准答案。根据编码习惯、Debug 方式、技术品味和面对报错的反应，编译出一种程序员人格。
			</p>
			<button class="cta" type="button" data-action="start">
				开始测试 <span aria-hidden="true">→</span>
			</button>
			<p class="hint mono">本地完成 · 不会上传答案 · 按 Enter 开始</p>
		</section>

		<section class="panel" data-panel="quiz" hidden>
			<div class="meter">
				<span class="kicker mono" data-progress-label>01 / 10</span>
				<div class="meter-track" aria-hidden="true">
					<span class="meter-fill" data-progress-fill></span>
				</div>
			</div>
			<article class="q-card" data-q-card aria-live="polite">
				<p class="kicker mono" data-q-kicker></p>
				<h2 data-q-title></h2>
				<div class="options" data-q-options></div>
			</article>
			<p class="hint mono">键盘 1–4 或 A–D 作答</p>
		</section>

		<section class="panel compile" data-panel="compile" hidden>
			<p class="kicker mono">Compiling</p>
			<div class="term" data-compile-log aria-live="polite"></div>
		</section>

		<section class="panel result" data-panel="result" hidden>
			<div class="seal">
				<p class="kicker mono">Resolved · <span data-r-serial>0x0000</span></p>
				<div class="identity">
					<div class="portrait">
						<img data-r-avatar alt="" width="112" height="112" decoding="async" />
					</div>
					<div>
						<h2 data-r-name></h2>
						<p class="en mono" data-r-en></p>
					</div>
				</div>
				<div class="tags" data-r-tags></div>
				<p class="blurb" data-r-blurb></p>
				<blockquote data-r-quote></blockquote>
				<div class="metrics">
					<svg class="radar" data-radar></svg>
					<div class="bars" data-r-bars></div>
				</div>
				<div class="actions">
					<button class="cta ghost" type="button" data-action="retry">重新测试</button>
					<button class="cta" type="button" data-action="share">生成结果卡片</button>
				</div>
				<p class="hint mono" data-share-status></p>
			</div>
		</section>
	</div>
</Page>

<style>
	.page-head {
		margin-bottom: 1.1rem;
		animation: rise 0.55s var(--ease) both;
	}

	.back {
		display: inline-block;
		font-size: 0.63rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
		text-decoration: none;
	}

	.back span {
		display: inline-block;
		transition: transform 0.25s var(--ease);
	}

	.back:hover {
		color: var(--accent);
	}

	.back:hover span {
		transform: translateX(-3px);
	}

	:global(.persona-stage) {
		--p-bg: #0b0e16;
		--p-text: #e8ecf4;
		--p-muted: #8b93a7;
		--p-line: rgba(232, 236, 244, 0.1);
		--p-accent: #8aa2ff;
		--p-accent-deep: #3b5bd0;
		--p-gold: #e2b657;
		--p-glass: rgba(14, 18, 28, 0.55);
		--p-ease: cubic-bezier(0.22, 0.61, 0.36, 1);
		position: relative;
		isolation: isolate;
		overflow: hidden;
		min-height: 38rem;
		padding: 2.1rem 1.7rem 2rem;
		border: 1px solid rgba(138, 162, 255, 0.18);
		border-radius: 18px;
		background:
			radial-gradient(80% 70% at 100% 0%, rgba(59, 91, 208, 0.22), transparent 58%),
			radial-gradient(70% 50% at 0% 100%, rgba(226, 182, 87, 0.1), transparent 62%),
			var(--p-bg);
		color: var(--p-text);
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.03) inset,
			0 24px 80px rgba(20, 22, 26, 0.18);
	}

	:global(.persona-stage .particles),
	:global(.persona-stage .grid),
	:global(.persona-stage .orb) {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	:global(.persona-stage .particles) {
		z-index: 0;
		display: block;
		width: 100%;
		height: 100%;
	}

	:global(.persona-stage .grid) {
		z-index: 0;
		background-image:
			linear-gradient(to right, rgba(232, 236, 244, 0.045) 1px, transparent 1px),
			linear-gradient(to bottom, rgba(232, 236, 244, 0.045) 1px, transparent 1px);
		background-size: 32px 32px;
		mask-image: radial-gradient(120% 90% at 50% 40%, #000 20%, transparent 78%);
		-webkit-mask-image: radial-gradient(120% 90% at 50% 40%, #000 20%, transparent 78%);
	}

	:global(.persona-stage .orb) {
		z-index: 0;
		filter: blur(40px);
		opacity: 0.7;
	}

	:global(.persona-stage .orb-a) {
		width: 220px;
		height: 220px;
		top: -80px;
		right: -40px;
		left: auto;
		bottom: auto;
		background: rgba(59, 91, 208, 0.45);
		animation: orb-drift 12s var(--p-ease) infinite alternate;
	}

	:global(.persona-stage .orb-b) {
		width: 180px;
		height: 180px;
		left: -50px;
		bottom: -60px;
		top: auto;
		right: auto;
		background: rgba(226, 182, 87, 0.22);
		animation: orb-drift 16s var(--p-ease) infinite alternate-reverse;
	}

	@keyframes orb-drift {
		from {
			transform: translate(0, 0);
		}
		to {
			transform: translate(-18px, 14px);
		}
	}

	:global(.persona-stage .corners) {
		position: absolute;
		inset: 12px;
		z-index: 2;
		pointer-events: none;
	}

	:global(.persona-stage .corners span) {
		position: absolute;
		width: 14px;
		height: 14px;
		border: 1px solid rgba(138, 162, 255, 0.55);
	}

	:global(.persona-stage .corners span:nth-child(1)) {
		top: 0;
		left: 0;
		border-right: 0;
		border-bottom: 0;
	}

	:global(.persona-stage .corners span:nth-child(2)) {
		top: 0;
		right: 0;
		border-left: 0;
		border-bottom: 0;
	}

	:global(.persona-stage .corners span:nth-child(3)) {
		bottom: 0;
		left: 0;
		border-right: 0;
		border-top: 0;
	}

	:global(.persona-stage .corners span:nth-child(4)) {
		right: 0;
		bottom: 0;
		border-left: 0;
		border-top: 0;
	}

	:global(.persona-stage .panel) {
		position: relative;
		z-index: 1;
		min-height: 33rem;
		display: none;
	}

	:global(.persona-stage .panel.is-on) {
		display: flex;
		flex-direction: column;
		justify-content: center;
		animation: panel-in 0.55s var(--p-ease) both;
	}

	@keyframes panel-in {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	:global(.persona-stage .kicker) {
		margin: 0 0 1rem;
		font-size: 0.63rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--p-accent);
	}

	:global(.persona-stage h1) {
		margin: 0;
		color: var(--p-text);
		font-size: clamp(2.2rem, 6vw, 3.3rem);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.08;
	}

	:global(.persona-stage h2) {
		margin: 0 0 1.2rem;
		color: var(--p-text);
		font-size: clamp(1.35rem, 3.4vw, 1.75rem);
		font-weight: 700;
		letter-spacing: -0.03em;
		line-height: 1.28;
	}

	:global(.persona-stage .lede-en) {
		margin: 0.85rem 0 0;
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--p-muted);
	}

	:global(.persona-stage .lede) {
		margin: 1.35rem 0 0;
		max-width: 38ch;
		color: #c5cad6;
		font-size: 0.98rem;
		line-height: 1.75;
	}

	:global(.persona-stage .cta) {
		align-self: flex-start;
		margin-top: 2rem;
		padding: 0.72rem 1.25rem;
		border: 1px solid var(--p-accent-deep);
		border-radius: 3px;
		background: var(--p-accent-deep);
		color: #fff;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		cursor: pointer;
		box-shadow: 0 0 28px rgba(59, 91, 208, 0.35);
		transition:
			background-color 0.2s var(--p-ease),
			border-color 0.2s var(--p-ease),
			transform 0.15s var(--p-ease),
			box-shadow 0.2s var(--p-ease);
	}

	:global(.persona-stage .cta span) {
		display: inline-block;
		transition: transform 0.25s var(--p-ease);
	}

	:global(.persona-stage .cta:hover span) {
		transform: translateX(4px);
	}

	:global(.persona-stage .cta:hover) {
		background: #4d6de0;
		border-color: #4d6de0;
		box-shadow: 0 0 36px rgba(138, 162, 255, 0.45);
	}

	:global(.persona-stage .cta:active) {
		transform: translateY(1px);
	}

	:global(.persona-stage .cta.ghost) {
		background: transparent;
		border-color: var(--p-line);
		color: var(--p-text);
		box-shadow: none;
	}

	:global(.persona-stage .cta.ghost:hover) {
		border-color: var(--p-accent);
		color: var(--p-accent);
		background: transparent;
	}

	:global(.persona-stage .hint) {
		margin: 1.1rem 0 0;
		min-height: 1.2em;
		font-size: 0.62rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--p-muted);
	}

	:global(.persona-stage .meter) {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1.6rem;
	}

	:global(.persona-stage .meter .kicker) {
		margin: 0;
		flex: none;
	}

	:global(.persona-stage .meter-track) {
		flex: 1;
		height: 2px;
		border-radius: 1px;
		background: rgba(232, 236, 244, 0.1);
		overflow: hidden;
	}

	:global(.persona-stage .meter-fill) {
		display: block;
		width: 0;
		height: 100%;
		background: linear-gradient(90deg, var(--p-accent-deep), var(--p-accent));
		box-shadow: 0 0 12px var(--p-accent);
		transition: width 0.45s var(--p-ease);
	}

	:global(.persona-stage .q-card) {
		padding: 1.5rem 1.4rem 1.3rem;
		border: 1px solid var(--p-line);
		border-radius: 12px;
		background: var(--p-glass);
		backdrop-filter: blur(18px) saturate(140%);
		-webkit-backdrop-filter: blur(18px) saturate(140%);
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.03) inset;
	}

	:global(.persona-stage .q-card.is-leave) {
		animation: card-out 0.28s var(--p-ease) both;
	}

	:global(.persona-stage .q-card.is-enter) {
		animation: card-in 0.42s var(--p-ease) both;
	}

	@keyframes card-out {
		to {
			opacity: 0;
			filter: blur(6px);
			transform: translateX(-22px) scale(0.985);
		}
	}

	@keyframes card-in {
		from {
			opacity: 0;
			filter: blur(6px);
			transform: translateX(26px) scale(0.985);
		}
		to {
			opacity: 1;
			filter: none;
			transform: none;
		}
	}

	:global(.persona-stage .options) {
		display: grid;
		gap: 0.55rem;
	}

	:global(.persona-stage .opt) {
		display: grid;
		grid-template-columns: 1.7rem minmax(0, 1fr);
		align-items: start;
		gap: 0.7rem;
		width: 100%;
		padding: 0.78rem 0.85rem;
		border: 1px solid var(--p-line);
		border-radius: 8px;
		background: rgba(255, 255, 255, 0.02);
		color: var(--p-text);
		text-align: left;
		cursor: pointer;
		transition:
			border-color 0.2s var(--p-ease),
			background-color 0.2s var(--p-ease),
			transform 0.18s var(--p-ease),
			box-shadow 0.2s var(--p-ease);
	}

	:global(.persona-stage .opt:hover),
	:global(.persona-stage .opt:focus-visible) {
		border-color: rgba(138, 162, 255, 0.55);
		background: rgba(138, 162, 255, 0.08);
		box-shadow: 0 0 24px rgba(59, 91, 208, 0.16);
		outline: none;
	}

	:global(.persona-stage .opt:active) {
		transform: translateY(1px);
	}

	:global(.persona-stage .opt.is-picked) {
		border-color: var(--p-accent);
		background: rgba(138, 162, 255, 0.14);
		box-shadow: 0 0 28px rgba(59, 91, 208, 0.28);
	}

	:global(.persona-stage .opt:disabled:not(.is-picked)) {
		opacity: 0.45;
	}

	:global(.persona-stage .opt-key) {
		padding-top: 0.12rem;
		font-size: 0.68rem;
		letter-spacing: 0.08em;
		color: var(--p-accent);
	}

	:global(.persona-stage .opt-text) {
		font-size: 0.95rem;
		line-height: 1.55;
	}

	:global(.persona-stage .compile) {
		justify-content: center;
	}

	:global(.persona-stage .term) {
		min-height: 10rem;
		padding: 1.2rem 1.3rem;
		border: 1px solid var(--p-line);
		border-radius: 10px;
		background: rgba(6, 8, 14, 0.55);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		line-height: 1.8;
		color: #c5cad6;
		box-shadow: 0 0 40px rgba(59, 91, 208, 0.08) inset;
	}

	:global(.persona-stage .term-line) {
		white-space: pre-wrap;
	}

	:global(.persona-stage .term-line:last-child::after) {
		content: '▍';
		margin-left: 0.15em;
		color: var(--p-accent);
		animation: caret 1s step-end infinite;
	}

	@keyframes caret {
		50% {
			opacity: 0;
		}
	}

	:global(.persona-stage .term-done) {
		margin-top: 0.6rem;
		color: var(--p-gold);
		text-shadow: 0 0 18px rgba(226, 182, 87, 0.35);
	}

	:global(.persona-stage .result) {
		justify-content: flex-start;
		padding-top: 0.4rem;
	}

	:global(.persona-stage .seal) {
		position: relative;
		overflow: hidden;
		padding: 1.5rem 1.4rem 1.4rem;
		border: 1px solid var(--p-line);
		border-radius: 12px;
		background: var(--p-glass);
		backdrop-filter: blur(18px) saturate(140%);
		-webkit-backdrop-filter: blur(18px) saturate(140%);
	}

	:global(.persona-stage .result.is-reveal .seal) {
		animation: seal-in 0.85s var(--p-ease) both;
	}

	:global(.persona-stage .result.is-reveal .seal::after) {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: linear-gradient(
			105deg,
			transparent 38%,
			rgba(255, 255, 255, 0.14) 50%,
			transparent 62%
		);
		animation: sweep 1.15s 0.25s var(--p-ease) both;
	}

	@keyframes seal-in {
		from {
			opacity: 0;
			filter: blur(10px);
			transform: translateY(18px) scale(0.97);
		}
		to {
			opacity: 1;
			filter: none;
			transform: none;
		}
	}

	@keyframes sweep {
		from {
			transform: translateX(-80%);
		}
		to {
			transform: translateX(80%);
		}
	}

	:global(.persona-stage .identity) {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 1rem;
	}

	:global(.persona-stage .identity > div) {
		min-width: 0;
	}

	:global(.persona-stage .portrait) {
		position: relative;
		flex: none;
		width: 6.6rem;
		height: 6.6rem;
		overflow: hidden;
		border: 1px solid rgba(138, 162, 255, 0.4);
		border-radius: 8px;
		background: rgba(12, 16, 28, 0.9);
		image-rendering: pixelated;
		box-shadow:
			0 0 0 1px rgba(255, 255, 255, 0.04) inset,
			0 0 28px rgba(59, 91, 208, 0.32);
	}

	:global(.persona-stage .portrait img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		image-rendering: pixelated;
	}

	:global(.persona-stage .result.is-reveal .portrait) {
		animation: glyph-pulse 2.4s 0.4s var(--p-ease) infinite;
	}

	@keyframes glyph-pulse {
		0%,
		100% {
			box-shadow: 0 0 22px rgba(59, 91, 208, 0.28);
		}
		50% {
			box-shadow: 0 0 34px rgba(138, 162, 255, 0.55);
		}
	}

	:global(.persona-stage .identity h2) {
		margin: 0;
		font-size: clamp(1.6rem, 4vw, 2.1rem);
	}

	:global(.persona-stage .result.is-reveal .identity h2) {
		animation: name-glow 2.8s 0.5s var(--p-ease) infinite;
	}

	@keyframes name-glow {
		0%,
		100% {
			text-shadow: 0 0 0 transparent;
		}
		50% {
			text-shadow: 0 0 24px rgba(138, 162, 255, 0.35);
		}
	}

	:global(.persona-stage .en) {
		margin: 0.25rem 0 0;
		font-size: 0.62rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--p-muted);
	}

	:global(.persona-stage .tags) {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 1rem;
	}

	:global(.persona-stage .tag) {
		padding: 0.18rem 0.5rem;
		border: 1px solid var(--p-line);
		border-radius: 99px;
		font-size: 0.58rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--p-muted);
	}

	:global(.persona-stage .blurb) {
		margin: 0 0 1rem;
		max-width: 52ch;
		color: #c5cad6;
		font-size: 0.95rem;
		line-height: 1.75;
	}

	:global(.persona-stage blockquote) {
		margin: 0 0 1.5rem;
		padding: 0 0 0 1rem;
		border-left: 2px solid var(--p-gold);
		color: var(--p-gold);
		font-size: 1rem;
		line-height: 1.65;
	}

	:global(.persona-stage .metrics) {
		display: grid;
		grid-template-columns: 210px minmax(0, 1fr);
		gap: 1.2rem 1.5rem;
		align-items: center;
		padding-top: 0.4rem;
		border-top: 1px solid var(--p-line);
	}

	:global(.persona-stage .radar) {
		width: 210px;
		height: 210px;
	}

	:global(.persona-stage .radar-ring),
	:global(.persona-stage .radar-axis) {
		fill: none;
		stroke: rgba(232, 236, 244, 0.12);
		stroke-width: 1;
	}

	:global(.persona-stage .radar-fill) {
		fill: rgba(59, 91, 208, 0.28);
		stroke: none;
	}

	:global(.persona-stage .radar-stroke) {
		fill: none;
		stroke: var(--p-accent);
		stroke-width: 1.6;
		filter: drop-shadow(0 0 6px rgba(138, 162, 255, 0.7));
	}

	:global(.persona-stage .radar-label) {
		fill: var(--p-muted);
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.08em;
	}

	:global(.persona-stage .radar-fill),
	:global(.persona-stage .radar-stroke) {
		transform-box: view-box;
		transform-origin: 140px 140px;
	}

	:global(.persona-stage .result.is-reveal .radar-fill),
	:global(.persona-stage .result.is-reveal .radar-stroke) {

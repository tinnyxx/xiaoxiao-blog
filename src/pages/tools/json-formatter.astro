---
import { SITE_TITLE } from '../../consts';
import Page from '../../layouts/Page.astro';
---

<Page title={`JSON 格式化 | ${SITE_TITLE}`} description="在浏览器中美化、压缩和复制 JSON。">
	<header class="page-head">
		<a class="back mono" href="/tools">
			<span aria-hidden="true">←</span> Utilities
		</a>
		<p class="label">Utility / 01 · JSON Formatter</p>
		<h1>JSON 格式化</h1>
		<p class="intro">粘贴 JSON 后可以美化、压缩或复制。全部在本地处理，不会发送到服务器。</p>
	</header>

	<div class="toolbar">
		<button id="format-btn" type="button">格式化</button>
		<button id="minify-btn" type="button">压缩</button>
		<button id="copy-btn" type="button">复制</button>
		<button id="clear-btn" type="button" class="ghost">清空</button>
	</div>
	<p id="status" class="status" aria-live="polite"></p>
	<label class="sr-only" for="json-input">JSON 内容</label>
	<textarea id="json-input" spellcheck="false" placeholder='{"hello":"xiaoxiao"}'></textarea>
</Page>

<style>
	.page-head {
		margin-bottom: 2rem;
		animation: rise 0.55s var(--ease) both;
	}
	.back {
		display: inline-block;
		margin-bottom: 1.8rem;
		font-size: 0.63rem;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
		text-decoration: none;
	}
	.back span {
		display: inline-block;
		transition: transform 0.25s var(--ease);
	}
	.back:hover {
		color: var(--accent);
	}
	.back:hover span {
		transform: translateX(-3px);
	}
	.page-head .label {
		margin-bottom: 0.8rem;
	}
	.page-head h1 {
		margin: 0;
		font-size: clamp(1.9rem, 4.4vw, 2.6rem);
		font-weight: 800;
		letter-spacing: -0.03em;
	}
	.intro {
		margin: 0.9rem 0 0;
		max-width: 46ch;
		color: var(--muted);
		font-size: 0.95rem;
	}
	.toolbar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 0.7rem;
		padding-top: 1.4rem;
		border-top: 1px solid var(--border);
	}
	/* One solid primary action; the rest stay quiet until hovered. */
	button {
		border: 1px solid var(--border);
		border-radius: 2px;
		padding: 0.42rem 0.95rem;
		background: transparent;
		color: var(--text-soft);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.08em;
		cursor: pointer;
		transition:
			background-color 0.2s var(--ease),
			border-color 0.2s var(--ease),
			color 0.2s var(--ease),
			transform 0.15s var(--ease);
	}
	button:hover {
		border-color: var(--accent-quiet);
		color: var(--accent);
	}
	button.ghost {
		border-color: transparent;
		color: var(--muted-soft);
	}
	button.ghost:hover {
		border-color: var(--border);
		color: var(--muted);
	}
	#format-btn {
		border-color: var(--accent);
		background: var(--accent);
		color: #fff;
	}
	#format-btn:hover {
		background: var(--accent-strong);
		border-color: var(--accent-strong);
		color: #fff;
	}
	button:active {
		transform: translateY(1px);
	}
	.status {
		min-height: 1.5em;
		margin: 0 0 0.7rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--muted);
	}
	.status.error {
		color: #b42318;
	}
	.status.ok {
		color: #027a48;
	}
	textarea {
		width: 100%;
		min-height: 420px;
		padding: 1rem;
		border: 1px solid var(--border);
		border-radius: 3px;
		background: var(--surface);
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 0.9rem;
		line-height: 1.6;
		resize: vertical;
		transition: border-color 0.2s var(--ease);
	}
	textarea:focus {
		outline: none;
		border-color: var(--accent-quiet);
	}
</style>

<script>
	const input = document.querySelector<HTMLTextAreaElement>('#json-input');
	const status = document.querySelector<HTMLParagraphElement>('#status');
	const formatBtn = document.querySelector('#format-btn');
	const minifyBtn = document.querySelector('#minify-btn');
	const copyBtn = document.querySelector('#copy-btn');
	const clearBtn = document.querySelector('#clear-btn');
	const invalid = Symbol('invalid-json');

	function setStatus(message: string, kind: '' | 'ok' | 'error' = '') {
		if (!status) return;
		status.textContent = message;
		status.className = `status${kind ? ` ${kind}` : ''}`;
	}

	function parseJson() {
		if (!input) return invalid;
		const raw = input.value.trim();
		if (!raw) {
			setStatus('请先粘贴 JSON。', 'error');
			return invalid;
		}
		try {
			return JSON.parse(raw);
		} catch (error) {
			const message = error instanceof Error ? error.message : 'JSON 无法解析';
			setStatus(message, 'error');
			return invalid;
		}
	}

	formatBtn?.addEventListener('click', () => {
		const data = parseJson();
		if (data === invalid || !input) return;
		input.value = JSON.stringify(data, null, 2);
		setStatus('已格式化。', 'ok');
	});

	minifyBtn?.addEventListener('click', () => {
		const data = parseJson();
		if (data === invalid || !input) return;
		input.value = JSON.stringify(data);
		setStatus('已压缩。', 'ok');
	});

	copyBtn?.addEventListener('click', async () => {
		if (!input?.value) {
			setStatus('没有可复制的内容。', 'error');
			return;
		}
		try {
			await navigator.clipboard.writeText(input.value);
			setStatus('已复制到剪贴板。', 'ok');
		} catch {
			input.select();
			setStatus('复制失败，请手动全选后复制。', 'error');
		}
	});

	clearBtn?.addEventListener('click', () => {
		if (input) input.value = '';
		setStatus('已清空。');
	});
</script>

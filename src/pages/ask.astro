---
import { SITE_TITLE } from '../consts';
import Page from '../layouts/Page.astro';

const suggestions = [
	'这个博客的 RAG 问答是怎么实现的？',
	'如何给 Astro 博客加上 SSR？',
	'DeepSeek 的流式输出是怎么处理的？',
];
---

<Page
	title={`AI 问答 | ${SITE_TITLE}`}
	description="基于本站文章的 RAG 智能问答助手。回答只依据已收录的文章，并附上引用来源。"
>
	<header class="page-head">
		<p class="label">AI / Ask</p>
		<h1>博客问答助手</h1>
		<p class="intro">
			这是一个检索增强生成（RAG）助手：先把你的问题在文章向量库里检索出最相关的片段，再交给
			DeepSeek 生成带引用的回答。所有答案只依据本站已收录的文章。
		</p>
	</header>

	<div class="ask" id="ask-app">
		<section class="chat" data-chat>
			<div class="empty" data-empty>
				<div class="mark" aria-hidden="true">✦</div>
				<p class="kicker mono">RAG Assistant</p>
				<p class="hint">问我任何与本站文章相关的问题</p>
				<div class="suggestions" data-suggestions>
					{
						suggestions.map((suggestion) => (
							<button type="button" class="suggest" data-suggest>{suggestion}</button>
						))
					}
				</div>
			</div>
			<div class="messages" data-messages hidden></div>
		</section>

		<form class="composer" data-composer>
			<label class="sr-only" for="ask-input">输入问题</label>
			<textarea
				id="ask-input"
				data-input
				rows="1"
				placeholder="输入问题，Enter 发送，Shift + Enter 换行"
			></textarea>
			<button type="submit" class="send" aria-label="发送">发送</button>
		</form>
		<p class="status mono" data-status aria-live="polite"></p>
	</div>
</Page>

<style>
	.page-head {
		margin-bottom: 2rem;
		animation: rise 0.55s var(--ease) both;
	}

	.page-head .label {
		margin-bottom: 0.9rem;
	}

	.page-head h1 {
		margin: 0;
		font-size: clamp(2.1rem, 5vw, 3.1rem);
		font-weight: 800;
		letter-spacing: -0.03em;
	}

	.intro {
		margin: 1rem 0 0;
		max-width: 52ch;
		color: var(--muted);
		font-size: 0.95rem;
		line-height: 1.7;
	}

	.ask {
		display: flex;
		flex-direction: column;
		min-height: 32rem;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: var(--surface);
		overflow: hidden;
	}

	.chat {
		flex: 1;
		min-height: 24rem;
		max-height: 62vh;
		overflow-y: auto;
		padding: 1.5rem 1.5rem 0.5rem;
	}

	.empty {
		min-height: 20rem;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		gap: 0.4rem;
	}

	.mark {
		width: 2.8rem;
		height: 2.8rem;
		display: grid;
		place-content: center;
		border: 1px solid var(--accent-quiet);
		border-radius: 50%;
		color: var(--accent);
		font-size: 1.1rem;
		margin-bottom: 0.7rem;
		box-shadow: 0 0 0 6px var(--accent-wash);
	}

	.kicker {
		font-size: 0.62rem;
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.hint {
		margin: 0.3rem 0 1.2rem;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.suggestions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		max-width: 40rem;
	}

	.suggest {
		padding: 0.45rem 0.85rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: transparent;
		color: var(--text-soft);
		font-size: 0.82rem;
		cursor: pointer;
		transition:
			border-color 0.2s var(--ease),
			color 0.2s var(--ease),
			background-color 0.2s var(--ease);
	}

	.suggest:hover {
		border-color: var(--accent-quiet);
		color: var(--accent);
		background: var(--accent-wash);
	}

	.messages {
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
	}

	.msg {
		display: flex;
		flex-direction: column;
		max-width: 88%;
	}

	.msg.user {
		align-self: flex-end;
	}

	.msg.assistant {
		align-self: flex-start;
	}

	.bubble {
		padding: 0.8rem 1rem;
		border-radius: 8px;
		font-size: 0.94rem;
		line-height: 1.7;
		white-space: pre-wrap;
		overflow-wrap: break-word;
	}

	.msg.user .bubble {
		background: var(--accent);
		color: #fff;
		border-top-right-radius: 2px;
	}

	.msg.assistant .bubble {
		background: var(--bg);
		border: 1px solid var(--border-soft);
		border-top-left-radius: 2px;
		color: var(--text-soft);
	}

	/* 让 Markdown 渲染出的标题/段落/代码在气泡里也好看 */
	.msg.assistant .bubble :global(h1),
	.msg.assistant .bubble :global(h2),
	.msg.assistant .bubble :global(h3),
	.msg.assistant .bubble :global(h4) {
		margin: 0.9rem 0 0.5rem;
		font-size: 1.05em;
	}

	.msg.assistant .bubble :global(h1:first-child),
	.msg.assistant .bubble :global(h2:first-child),
	.msg.assistant .bubble :global(h3:first-child),
	.msg.assistant .bubble :global(h4:first-child),
	.msg.assistant .bubble :global(p:first-child) {
		margin-top: 0;
	}

	.msg.assistant .bubble :global(p) {
		margin: 0 0 0.7em;
	}

	.msg.assistant .bubble :global(p:last-child) {
		margin-bottom: 0;
	}

	.msg.assistant .bubble :global(pre) {
		margin: 0.8rem 0;
		background: var(--surface);
	}

	.cursor {
		display: inline-block;
		width: 0.55em;
		height: 1.05em;
		margin-left: 2px;
		vertical-align: text-bottom;
		background: var(--accent);
		animation: blink 1s step-end infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.sources {
		margin: 0.5rem 0 0;
		padding-left: 1.2rem;
		font-size: 0.78rem;
		color: var(--muted);
	}

	.sources a {
		color: var(--muted);
	}

	.sources a:hover {
		color: var(--accent);
	}

	.composer {
		display: flex;
		align-items: flex-end;
		gap: 0.6rem;
		padding: 0.9rem 1rem;
		border-top: 1px solid var(--border-soft);
		background: var(--bg);
	}

	.composer textarea {
		flex: 1;
		resize: none;
		max-height: 180px;
		padding: 0.6rem 0.8rem;
		border: 1px solid var(--border);
		border-radius: 4px;
		background: var(--surface);
		color: var(--text);
		font-family: inherit;
		font-size: 0.94rem;
		line-height: 1.5;
		transition: border-color 0.2s var(--ease);
	}

	.composer textarea:focus {
		outline: none;
		border-color: var(--accent-quiet);
	}

	.send {
		flex: none;
		padding: 0.6rem 1.2rem;
		border: 1px solid var(--accent);
		border-radius: 4px;
		background: var(--accent);
		color: #fff;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		cursor: pointer;
		transition:
			background-color 0.2s var(--ease),
			border-color 0.2s var(--ease);
	}

	.send:hover {
		background: var(--accent-strong);
		border-color: var(--accent-strong);
	}

	.composer[data-busy='true'] .send {
		opacity: 0.6;
		cursor: not-allowed;
	}

	.status {
		min-height: 1.3em;
		margin: 0;
		padding: 0.4rem 1rem 0.7rem;
		font-size: 0.72rem;
		color: #b42318;
		background: var(--bg);
	}

	.status:empty {
		padding-bottom: 0;
	}

	@media (max-width: 767px) {
		.chat {
			max-height: 58vh;
			padding: 1.1rem 1rem 0.4rem;
		}

		.msg {
			max-width: 96%;
		}
	}
</style>

<script>
	import { mountAsk } from '../scripts/ask';

	const root = document.getElementById('ask-app');
	if (root) mountAsk(root);
</script>

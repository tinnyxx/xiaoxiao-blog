---
import SiteLayout from './SiteLayout.astro';

interface Props {
	title: string;
	description: string;
	wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
---

<SiteLayout title={title} description={description}>
	<main class:list={{ wide }}>
		<slot />
	</main>
</SiteLayout>

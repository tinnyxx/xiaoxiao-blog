---
/** Reveals every [data-reveal] element once, with a small stagger per batch. */
---

<script>
	const items = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (items.length) {
		if (reduceMotion || !('IntersectionObserver' in window)) {
			for (const item of items) item.classList.add('is-visible');
		} else {
			const observer = new IntersectionObserver(
				(entries) => {
					let step = 0;
					for (const entry of entries) {
						const target = entry.target as HTMLElement;
						if (entry.isIntersecting) {
							target.style.transitionDelay = `${step * 70}ms`;
							step += 1;
						} else if (entry.boundingClientRect.bottom > 0) {
							// Still below the fold: wait until it scrolls into view.
							continue;
						}
						// Anything already scrolled past shows up without animating,
						// so a restored scroll position never leaves gaps.
						target.classList.add('is-visible');
						observer.unobserve(target);
					}
				},
				{ rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
			);

			for (const item of items) observer.observe(item);
		}
	}
</script>

---
import FormattedDate from './FormattedDate.astro';

interface Props {
	/** 1-based position in the sorted list; rendered as 001, 002, ... */
	index: number;
	href: string;
	title: string;
	date: Date;
	description?: string;
	last?: boolean;
}

const { index, href, title, date, description, last = false } = Astro.props;
const number = String(index).padStart(3, '0');
---

<li class:list={['note', { last }]} data-reveal>
	<a class="note-link" href={href}>
		<span class="num mono">{number}</span>
		<span class="body">
			<span class="title">{title}</span>
			{description && <span class="desc">{description}</span>}
			<span class="foot mono">
				<FormattedDate date={date} />
				<span class="arrow" aria-hidden="true">→</span>
			</span>
		</span>
	</a>
</li>

<style>
	.note {
		position: relative;
		padding-left: 1.9rem;
	}

	.note:not(.last) {
		border-bottom: 1px solid var(--border-soft);
	}

	/* Timeline: a hairline through every row plus one node per entry. */
	.note::after {
		content: '';
		position: absolute;
		left: 4px;
		top: 0;
		bottom: 0;
		width: 1px;
		background: var(--border);
	}

	.note.last::after {
		bottom: auto;
		height: 2.4rem;
		background: linear-gradient(var(--border), transparent);
	}

	.note::before {
		content: '';
		position: absolute;
		left: 1px;
		top: 1.75rem;
		z-index: 1;
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--bg);
		box-shadow: inset 0 0 0 1px var(--muted);
		transition:
			box-shadow 0.3s var(--ease),
			background-color 0.3s var(--ease),
			transform 0.3s var(--ease);
	}

	.note:hover::before {
		background: var(--accent);
		box-shadow: inset 0 0 0 1px var(--accent);
		transform: scale(1.15);
	}

	.note-link {
		position: relative;
		display: grid;
		grid-template-columns: 2.9rem 1fr;
		align-items: start;
		padding: 1.35rem 0.2rem 1.4rem;
		text-decoration: none;
		color: inherit;
		transition: transform 0.3s var(--ease);
	}

	.note-link:hover {
		transform: translateX(6px);
	}

	/* Thin connector that grows out of the timeline on hover. */
	.note-link::before {
		content: '';
		position: absolute;
		left: -1.15rem;
		top: 1.85rem;
		width: 0;
		height: 1px;
		background: var(--accent-quiet);
		transition: width 0.3s var(--ease);
	}

	.note-link:hover::before {
		width: 0.85rem;
	}

	.num {
		padding-top: 0.35rem;
		font-size: 0.65rem;
		letter-spacing: 0.06em;
		color: var(--muted-soft);
		transition: color 0.25s var(--ease);
	}

	.note-link:hover .num {
		color: var(--accent-quiet);
	}

	.body {
		display: block;
		min-width: 0;
	}

	.title {
		display: block;
		color: var(--text);
		font-size: 1.12rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.45;
		transition: color 0.25s var(--ease);
	}

	.note-link:hover .title {
		color: var(--accent);
	}

	.desc {
		display: block;
		margin-top: 0.35rem;
		color: var(--muted);
		font-size: 0.92rem;
		line-height: 1.65;
	}

	.foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 0.75rem;
		font-size: 0.63rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted-soft);
	}

	.arrow {
		color: var(--accent);
		font-size: 0.85rem;
		opacity: 0;
		transform: translateX(-5px);
		transition:
			opacity 0.3s var(--ease),
			transform 0.3s var(--ease);
	}

	.note-link:hover .arrow {
		opacity: 1;
		transform: none;
	}

	@media (max-width: 767px) {
		.note {
			padding-left: 1.4rem;
		}
		.note-link {
			grid-template-columns: 2.4rem 1fr;
			padding: 1.1rem 0 1.15rem;
		}
		.title {
			font-size: 1.05rem;
		}
		.arrow {
			opacity: 1;
			transform: none;
		}
	}
</style>

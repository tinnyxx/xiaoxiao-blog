---
/**
 * The visual signature of 小小博客: a center node (the person), two orbits
 * (notes and tools) and four quiet markers (experiments). Pure SVG + CSS.
 */
---

<div class="mark" data-garden-mark aria-hidden="true">
	<svg viewBox="0 0 200 200" fill="none" stroke-linecap="round">
		<line class="axis" x1="100" y1="16" x2="100" y2="184"></line>
		<line class="axis" x1="16" y1="100" x2="184" y2="100"></line>

		<circle class="ring dotted" cx="100" cy="100" r="72"></circle>
		<circle class="ring" cx="100" cy="100" r="38"></circle>

		<circle class="seed" cx="150.9" cy="49.1" r="1.6"></circle>
		<circle class="seed" cx="150.9" cy="150.9" r="1.6"></circle>
		<circle class="seed" cx="49.1" cy="150.9" r="1.6"></circle>
		<circle class="seed" cx="49.1" cy="49.1" r="1.6"></circle>

		<g class="orbit orbit-outer">
			<circle class="traveller" cx="100" cy="28" r="3"></circle>
		</g>
		<g class="orbit orbit-inner">
			<circle class="traveller small" cx="100" cy="62" r="2"></circle>
		</g>

		<circle class="halo" cx="100" cy="100" r="12"></circle>
		<circle class="node" cx="100" cy="100" r="4.2"></circle>
	</svg>
</div>

<style>
	.mark {
		width: clamp(150px, 17vw, 216px);
		aspect-ratio: 1;
		will-change: transform;
	}

	/* Entrance lives on the svg so the pointer-follow transform on .mark stays free. */
	.mark svg {
		width: 100%;
		height: 100%;
		overflow: visible;
		animation: mark-in 0.7s var(--ease) 0.15s both;
	}

	@keyframes mark-in {
		from {
			opacity: 0;
			transform: scale(0.92);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.axis {
		stroke: var(--border);
		stroke-width: 1;
	}

	.ring {
		stroke: var(--muted-soft);
		stroke-width: 1;
		opacity: 0.7;
	}

	.ring.dotted {
		stroke-dasharray: 1 5;
		opacity: 0.85;
	}

	.seed {
		fill: var(--muted);
		opacity: 0.85;
	}

	.orbit {
		transform-origin: 100px 100px;
		animation: spin 26s linear infinite;
	}

	.orbit-inner {
		animation-duration: 17s;
		animation-direction: reverse;
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	.traveller {
		fill: var(--accent);
	}

	.traveller.small {
		fill: var(--accent-quiet);
		opacity: 0.75;
	}

	.halo {
		stroke: var(--accent-quiet);
		stroke-width: 1;
		opacity: 0.35;
		animation: breathe 5s var(--ease) infinite;
		transform-origin: 100px 100px;
	}

	@keyframes breathe {
		0%,
		100% {
			transform: scale(1);
			opacity: 0.35;
		}
		50% {
			transform: scale(1.16);
			opacity: 0.12;
		}
	}

	.node {
		fill: var(--text);
	}

	@media (max-width: 767px) {
		.mark {
			width: 118px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.orbit,
		.halo {
			animation: none;
		}
	}
</style>

<script>
	const mark = document.querySelector<HTMLElement>('[data-garden-mark]');
	const finePointer = window.matchMedia('(pointer: fine)').matches;
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (mark && finePointer && !reduceMotion) {
		const max = 8;
		let targetX = 0;
		let targetY = 0;
		let currentX = 0;
		let currentY = 0;
		let frame = 0;

		const clamp = (value: number) => Math.max(-max, Math.min(max, value));

		const tick = () => {
			currentX += (targetX - currentX) * 0.08;
			currentY += (targetY - currentY) * 0.08;
			mark.style.transform = `translate(${currentX.toFixed(2)}px, ${currentY.toFixed(2)}px)`;

			if (Math.abs(targetX - currentX) > 0.05 || Math.abs(targetY - currentY) > 0.05) {
				frame = requestAnimationFrame(tick);
			} else {
				frame = 0;
			}
		};

		window.addEventListener(
			'mousemove',
			(event) => {
				const box = mark.getBoundingClientRect();
				targetX = clamp((event.clientX - (box.left + box.width / 2)) * 0.03);
				targetY = clamp((event.clientY - (box.top + box.height / 2)) * 0.03);
				if (!frame) frame = requestAnimationFrame(tick);
			},
			{ passive: true },
		);
	}
</script>

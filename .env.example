# ==== DeepSeek 大模型（必填，用于生成回答）====
# 在 https://platform.deepseek.com 申请 API Key
DEEPSEEK_API_KEY=

# ==== 可选配置 ====
# DeepSeek 接口地址（默认 https://api.deepseek.com）
# DEEPSEEK_API_BASE=https://api.deepseek.com
# 模型名（默认 deepseek-chat）
# DEEPSEEK_MODEL=deepseek-chat

# ==== Embedding 后端 ====
# local：本地模型 Xenova/bge-small-zh-v1.5（默认，推荐；首次会从 HuggingFace 下载模型）
# hash ：离线降级方案，无需下载模型，仅用于开发调试
EMBEDDING_PROVIDER=local

# ==== HuggingFace 镜像（可选，国内服务器推荐）====
# 服务器访问 huggingface.co 困难时，设置镜像地址
# HF_ENDPOINT=https://hf-mirror.com

# ==== 数据目录（默认 ./data）====
# RAG 索引缓存（rag-index.json）会写到这里
# DATA_DIR=./data
